{
    "phases": {
      "setup": {
        "nixPkgs": ["nodejs_20", "pnpm-8_x", "openssl"]
      },
      "install": {
        "cmds": ["pnpm install --frozen-lockfile"]
      },
      "build": {
        "cmds": ["./node_modules/.bin/next build"],
        "cache": {
          "enable": true,
          "paths": [".next/cache", "node_modules/.cache"]
        }
      }
    },
    "start": {
      "cmd": "pnpm run start"
    },
    "variables": {
      "NODE_ENV": "production",
      "NEXT_TELEMETRY_DISABLED": "1"
    }
  }